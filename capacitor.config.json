{
  "appId": "in.pgease.owner",
  "appName": "PG Ease Manager",
  "webDir": "dist",
  "appendUserAgent": "PGEaseApp",
  "server": {
    "androidScheme": "https",
    "iosScheme": "https",
    "hostname": "app.pgease.com",
    "errorPath": "offline.html",
    "cleartext": true,
    "allowNavigation": [
      "*.pgease.com",
      "*.pgease.in",
      "am4eey3lmk.execute-api.ap-south-1.amazonaws.com",
      "*.execute-api.ap-south-1.amazonaws.com",
      "*.easebuzz.in",
      "*.razorpay.com",
      "*.digio.in",
      "*.cashfree.com",
      "*.payu.in",
      "*.payumoney.com",
      "*.billdesk.com",
      "*.ccavenue.com",
      "*.stripe.com",
      "*.juspay.in",
      "*.phonepe.com",
      "*.cardinalcommerce.com",
      "*.arcot.com",
      "*.wibmo.com",
      "ebz-static.s3.ap-south-1.amazonaws.com"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "launchAutoHide": true,
      "backgroundColor": "#008080",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "splashFullScreen": false,
      "splashImmersive": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#008080",
      "overlaysWebView": false
    },
    "SystemBars": {
      "style": "DARK",
      "insetsHandling": "disable"
    },
    "Keyboard": {
      "resize": "body",
      "style": "LIGHT"
    }
  }
}
