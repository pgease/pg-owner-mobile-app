{
  "appId": "in.pgease.owner",
  "appName": "PG Ease Owner",
  "webDir": "dist",
  "appendUserAgent": "PGEaseApp",
  "server": {
    "androidScheme": "https",
    "iosScheme": "https",
    "cleartext": true,
    "url": "https://app.pgease.com?app=1",
    "allowNavigation": [
      "*.easebuzz.in",
      "*.razorpay.com",
      "*.digio.in",
      "*.cashfree.com",
      "*.payu.in",
      "*.payumoney.com",
      "*.billdesk.com",
      "*.ccavenue.com",
      "*.stripe.com",
      "*.juspay.in",
      "*.phonepe.com",
      "*.cardinalcommerce.com",
      "*.arcot.com",
      "*.wibmo.com",
      "ebz-static.s3.ap-south-1.amazonaws.com"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#005045",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "SystemBars": {
      "insetsHandling": "disable",
      "style": "DARK"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#008080",
      "overlaysWebView": true
    },
    "Keyboard": {
      "resize": "none",
      "style": "LIGHT",
      "resizeOnFullScreen": true
    }
  }
}
